# Skopiuj ten plik do .env i uzupełnij wartości (.env jest w .gitignore)

# Neon PostgreSQL — POOLED connection string (host z "-pooler"); używany w runtime przez aplikację
# Format: postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Neon DIRECT connection string (host BEZ "-pooler"); używany do migracji / prisma db push
# Format: postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=

# Sekret do podpisywania JWT — wygeneruj np.:  openssl rand -base64 32
JWT_SECRET=

# development | production  (steruje flagą Secure na cookie)
NODE_ENV=development

# Port lokalnego serwera backendu (opcjonalne, domyślnie 3001)
PORT=3001

# Klucz Anthropic (Claude API) — wyszukiwarka kodu celnego AI w kroku 2 kreatora.
# WYŁĄCZNIE po stronie serwera (nigdy w bundlu frontendu). Ustaw też w env Vercela.
ANTHROPIC_API_KEY=

# Klucz do Freightos (stawki frachtowe na /routes) — OPCJONALNY.
# Pusty klucz jest poprawny: endpoint shippingCalculator działa bez niego
# w trybie estimate, a gdy zmienna jest pusta, po prostu nie trafia do zapytania.
FREIGHTOS_API_KEY=

# ShipsGo Ocean API (śledzenie kontenerów w zakładce „Śledzenie ładunku") —
# domyślnie WYŁĄCZONE. Mamy tylko 2 kredyty testowe, każde "Włącz śledzenie"
# kosztuje kredyt — nie włączać na produkcji bez wyceny. Ustaw obie zmienne
# razem, DOSŁOWNIE "true" (nie "false" ani cokolwiek innego — string
# niepusty ≠ włączone, sprawdzane jest dosłowne dopasowanie do 'true'):
SHIPSGO_ENABLED=false
SHIPSGO_API_TOKEN=

# Dopóki nie wykupimy pakietu ShipsGo: lista e-maili (po przecinku) z dostępem
# do przycisku "Włącz śledzenie", nawet gdy SHIPSGO_ENABLED=true na produkcji.
# Puste/nieustawione = brak zawężenia (widoczne dla wszystkich userów) —
# docelowy stan PO wykupieniu pakietu, wtedy po prostu wyczyść tę zmienną.
SHIPSGO_ALLOWED_EMAILS=

# Sekret do weryfikacji podpisu webhooka ShipsGo (HMAC-SHA256 z surowego body,
# nagłówek X-Shipsgo-Webhook-Signature). Skąd go wziąć: dashboard ShipsGo →
# Settings → Webhooks → dodaj endpoint, sekret wyświetla się przy tworzeniu.
# URL do wpisania po stronie ShipsGo:
#   https://TWOJA-DOMENA/api/tracking/shipsgo-webhook
# Zdarzenia: OCEAN.SHIPMENTS.SHIPMENT_UPDATED i OCEAN.SHIPMENTS.SHIPMENT_DELETED.
# Bez tej zmiennej webhook odrzuca KAŻDE żądanie (401) — aktualizacje przyjdą
# wtedy dopiero przy ręcznym odświeżeniu.
SHIPSGO_WEBHOOK_SECRET=
