// Prisma schema dla AmLogistico
// Baza: PostgreSQL (Neon). Connection string w env DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (z "-pooler") — zapytania aplikacji w runtime
  directUrl = env("DIRECT_URL")   // direct (bez "-pooler") — migracje / db push
}

// users — konta użytkowników (zgodne z docs/3.Baza danych.md)
model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  companyName      String?   @map("company_name") // opcjonalne — rejestracja nie wymaga firmy
  vatNumber        String?   @map("vat_number")
  plan             String    @default("free") // free / monthly / pay_per_doc
  planExpiresAt    DateTime? @map("plan_expires_at")
  stripeCustomerId String?   @map("stripe_customer_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  // Dane podstawowe zbierane przy rejestracji (nullable w bazie — tabela ma już
  // rekordy; wymagalność egzekwuje Zod, nie schemat)
  fullName         String?   @map("full_name")
  phone            String?
  termsAcceptedAt  DateTime? @map("terms_accepted_at")
  marketingConsent Boolean   @default(false) @map("marketing_consent")

  // Profil rozszerzony — zawsze opcjonalny (auto-fill nadawcy w kreatorze)
  profileCompleted  Boolean  @default(false) @map("profile_completed")
  eoriNumber        String?  @map("eori_number")
  address           String?
  city              String?
  postalCode        String?  @map("postal_code")
  country           String?
  defaultCurrency   String?  @map("default_currency")
  preferredLanguage String?  @default("PL") @map("preferred_language")

  // Uprawnienie administratora (wysyłanie powiadomień). Nadawane ręcznie w Prisma
  // Studio — brak UI do zarządzania adminami (MVP).
  isAdmin           Boolean  @default(false) @map("is_admin")

  // Odroczenie powiadomienia automatycznego „Uzupełnij dane firmy" (7 dni od
  // ostatniej akcji użytkownika). Znacznik MUSI leżeć na koncie, a nie na
  // powiadomieniu: „X" w dzwonku kasuje wiersz powiadomienia fizycznie, więc
  // znacznik zapisany tam zginąłby razem z nim i zachęta wracałaby natychmiast
  // przy najbliższym pobraniu listy.
  // `profileReminderLastAction` ('dismissed' po „X", 'read' po przeczytaniu) nie
  // wpływa na żadną decyzję — służy wyłącznie późniejszej analizie zachowań.
  profileReminderDismissedAt DateTime? @map("profile_reminder_dismissed_at")
  profileReminderLastAction  String?   @map("profile_reminder_last_action")

  documentSets       DocumentSet[]
  notifications      Notification[]
  containerTrackings ContainerTrackingUser[]

  @@map("users")
}

// notifications — powiadomienia w aplikacji (dzwonek). Jeden wiersz na użytkownika,
// niezależnie od źródła. Dwa źródła, JEDNA tabela i jedna lista w dzwonku:
//   • wysyłka admina (kind = ADMIN_MESSAGE), na konkretne konto albo fan-out do wszystkich,
//   • powiadomienia generowane automatycznie (kind = PROFILE_COMPANY_DATA), tworzone
//     leniwie przy pobraniu listy przez api/_lib/autoNotifications.js.
//
// DLACZEGO `kind`, A NIE `type` (decyzja 2026-08-07): pole `type` istnieje od początku
// i niesie WAGĘ WIZUALNĄ (info/success/warning) — steruje ikoną i kolorem kafelka
// w dzwonku oraz jest częścią kontraktu panelu admina (Zod + formularz wysyłki).
// Kategoria powiadomienia musiała więc dostać własną kolumnę, zamiast nadpisywać `type`.
//
// STAN POWIADOMIENIA TO JEDNO POLE: `readAt`. Puste = nieprzeczytane (liczy się do
// czerwonej cyfry przy dzwonku), wypełnione = przeczytane (wpis zostaje w dzwonku,
// tylko przygaszony). Trzeciego stanu nie ma, bo „X" KASUJE wiersz na stałe —
// dzwonek jest jedyną historią powiadomień i nie ma osobnej podstrony, na której
// zamknięte wpisy mogłyby zalegać.
//
// `params` niesie wartości do wstawienia w tłumaczoną treść powiadomienia
// automatycznego (dziś żadne ich nie potrzebuje, ale mechanizm jest gotowy).
// Powiadomienia admina mają w `title`/`body` prawdziwy tekst wpisany ręcznie.
//
// Powtórne wygenerowanie powiadomienia automatycznego po 7 dniach od ostatniej akcji
// (znacznik `users.profile_reminder_dismissed_at`) chroni CZĘŚCIOWY indeks unikalny
// (user_id, kind) WHERE read_at IS NULL i kind w zbiorze automatycznych — zakładany
// przez scripts/apply-notification-index.js (Prisma nie deklaruje indeksów z warunkiem
// WHERE). Bez niego dwie karty przeglądarki odpytujące listę równocześnie potrafiłyby
// utworzyć dwa rekordy. Powiadomień admina indeks celowo NIE obejmuje — tych może być
// wiele nieprzeczytanych naraz.
model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind      String    @default("ADMIN_MESSAGE") // ADMIN_MESSAGE | PROFILE_COMPANY_DATA
  type      String    @default("info") // waga wizualna: info | success | warning
  title     String
  body      String
  ctaLabel  String?   @map("cta_label") // etykieta przycisku (opcjonalnie)
  ctaUrl    String?   @map("cta_url")   // link przycisku (opcjonalnie)
  params    Json? // parametry treści powiadomień automatycznych (interpolacja i18n)

  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([userId, kind, createdAt])
  @@map("notifications")
}

// document_sets — zapisane komplety dokumentów (migawka formData, NIE pliki PDF).
// Kształt kolumn odwzorowuje obiekt z src/services/documentSetsRepo.js, żeby
// mapowanie repo ⇄ baza było 1:1. PDF-y regenerujemy z form_data na żądanie.
model DocumentSet {
  id             String  @id @default(uuid())
  userId         String  @map("user_id")
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  status         String  // "draft" | "completed"
  kind           String? // np. "blank" dla setów z pustych szablonów (domyślnie null)
  flowType       String  @map("flow_type") // have_transport | find_transport | blank_templates
  totalSteps     Int     @map("total_steps")
  derivedFromId  String? @map("derived_from_id") // edycja completed → id oryginału

  lastStep       Int     @map("last_step")
  maxStepReached Int     @map("max_step_reached")

  templateVersion String @map("template_version") // wersja szablonów użyta przy secie

  // Migawki serializowane jako JSON (repo trzyma je jako obiekty).
  formData       Json    @map("form_data")     // cały snapshot kreatora
  engineResult   Json?   @map("engine_result") // wynik doboru dokumentów
  selectedDocs   Json    @map("selected_docs") // klucze wygenerowanych dokumentów
  meta           Json    // metadane karty/wyszukiwarki (trasa, tryb, opis, data)

  // Płaskie kolumny do szybkich zapytań listy (bez ładowania form_data).
  transportMode  String? @map("transport_mode")
  countryFrom    String? @map("country_from")
  countryTo      String? @map("country_to")

  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("document_sets")
}

// cn_codes — nomenklatura CN/TARIC z ISZTAR4 (Ministerstwo Finansów). Źródło prawdy
// dla walidacji kodów celnych podkategorii towaru. Zasilane WYŁĄCZNIE offline przez
// scripts/sync-isztar.js (nigdy z requestu użytkownika).
//
// Uwagi o rozbieżności model⇄API (rekonesans 2026-07-23):
//  - ISZTAR endpoint `codes?date=` zwraca DRZEWO aktywne na dany dzień, bez jawnych
//    dat obowiązywania per kod. Dlatego `validFrom` = data pierwszej synchronizacji,
//    a `validTo` ustawiamy dopiero, gdy kod ZNIKNIE z API w kolejnym przebiegu
//    (kodów NIE kasujemy — historyczne są potrzebne do starych dokumentów).
//  - API emituje `code` tylko dla poziomów 6-cyfrowego (podpozycja CN) i 10-cyfrowego
//    (TARIC). Poziomy 2/4 (dział/pozycja) są węzłami bez `code` — nie zapisujemy ich.
//    Kod CN8 z bazy podkategorii waliduje się jako PREFIKS aktywnego kodu 10-cyfrowego.
model CnCode {
  code          String    @id                 // kod bez kropek (6 lub 10 cyfr)
  cn8           String    @map("cn8")          // pierwsze ≤8 cyfr kodu (do dopasowań CN8)
  parentCode    String?   @map("parent_code")  // najbliższy kod nadrzędny w drzewie
  level         Int                            // długość kodu (6 lub 10)
  descriptionPl String    @map("description_pl")
  descriptionEn String?   @map("description_en")
  validFrom     DateTime  @map("valid_from")   // data pierwszej synchronizacji (nie realna data KE)
  validTo       DateTime? @map("valid_to")     // ustawiane, gdy kod zniknie z ISZTAR
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([cn8])
  @@index([descriptionPl])
  @@map("cn_codes")
}

// hs_suggestion_cache — cache wyników wyszukiwarki kodu celnego AI (krok 2 kreatora).
// Klucz = sha256(lowercase(trim(description)) + countryFrom + countryTo). TTL 90 dni
// egzekwowane w kodzie (po createdAt). Trafienie w cache = zero wywołań Claude API.
model HsSuggestionCache {
  key           String   @id // sha256 hex
  description   String
  countryFrom   String   @map("country_from")
  countryTo     String   @map("country_to")
  result        Json     // pełna odpowiedź zwracana frontendowi (suggestions, destination, ...)
  usedWebSearch Boolean  @default(false) @map("used_web_search")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("hs_suggestion_cache")
}

// hs_choice_log — który kod user FAKTYCZNIE wybrał („Użyj") spośród sugestii AI.
// Do oceny skuteczności wyszukiwarki po wdrożeniu (czy user bierze pierwszą sugestię,
// czy dalszą, czy w ogóle). userId to plain string (bez relacji — to log analityczny).
model HsChoiceLog {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  description    String
  countryFrom    String   @map("country_from")
  countryTo      String   @map("country_to")
  chosenCode     String   @map("chosen_code")
  source         String   // 'classify' (CN8/HS-6) | 'destination' (kraj docelowy)
  verified       Boolean? // dla source=destination: czy kod był zweryfikowany źródłem
  suggestedCodes Json     @map("suggested_codes") // kody pokazane userowi (ocena trafności)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("hs_choice_log")
}

// container_tracking — TRWAŁY rejestr śledzeń ShipsGo, jeden wiersz na REJS
// (nie na usera, nie na zestaw dokumentów). Zastępuje dawny cache w pamięci
// procesu, który znikał przy każdym cold-starcie na Vercelu i przez to nie
// chronił kredytów (patrz komentarz w api/_routes/shipsgoTracking.js).
//
// Dlaczego rejestr jest wspólny: kredyt ShipsGo jest naliczany za utworzenie
// śledzenia, a to samo pudło może być sprawdzone i z wyszukiwarki („Numer
// kontenera"), i z własnej przesyłki („Włącz śledzenie"). Wspólny wiersz
// = jedno płatne utworzenie na rejs, niezależnie od ścieżki w aplikacji.
//
// DLACZEGO NUMER KONTENERA NIE JEST KLUCZEM (zmiana 2026-08-06): ten sam
// kontener fizyczny wraca w kolejnych rejsach. CGMU6913205 płynie dziś
// z Szanghaju do Gdańska, a za trzy miesiące z Hamburga do Nowego Jorku —
// ten sam numer, zupełnie inny transport. Kredyt pokrywa jeden rejs; po jego
// zakończeniu ShipsGo ustawia `discarded_at` i przestaje aktualizować dane.
// Rekordy archiwalne ZOSTAJĄ (to wartościowa historia), a zasadę „co najwyżej
// jeden AKTYWNY rejs na numer" wymusza CZĘŚCIOWY indeks unikalny, zakładany
// osobno przez scripts/apply-tracking-index.js (Prisma nie deklaruje indeksów
// z warunkiem WHERE w schemacie). Definicja rekordu aktywnego:
//   discarded_at IS NULL AND status NOT IN ('DISCHARGED', 'UNTRACKED')
//
// Dwie kolumny stanu, celowo rozdzielone:
//   status     - stan REJSU wg ShipsGo (NEW, INPROGRESS, BOOKED, LOADED,
//                SAILING, ARRIVED, DISCHARGED, UNTRACKED)
//   fetchState - stan NASZEGO pobierania: pending (POST poszedł, dane jeszcze
//                niekompletne) | ready (mamy co pokazać) | failed (ShipsGo
//                trwale odrzuciło numer, 404/422 — nie ponawiaj automatycznie,
//                żeby nie palić kredytów na błędny numer)
model ContainerTracking {
  id              String    @id @default(uuid())
  shipsgoId       Int?      @unique @map("shipsgo_id") // id przesyłki po stronie ShipsGo; null między rezerwacją a odpowiedzią
  containerNumber String    @map("container_number") // znormalizowany ISO 6346; INDEKSOWANY, ale NIE unikalny
  bookingNumber   String?   @map("booking_number")
  carrierScac     String?   @map("carrier_scac")
  carrierName     String?   @map("carrier_name")
  status          String    @default("NEW") // status rejsu wg ShipsGo
  fetchState      String    @default("pending") @map("fetch_state") // pending | ready | failed
  lastError       String?   @map("last_error") // kod błędu z ostatniej nieudanej próby
  snapshot        Json? // trimShipmentData(); null dopóki brak danych
  geojson         Json? // trimGeojson(); trasa do narysowania na mapie
  mapToken        String?   @map("map_token") // tokens.map — link do pełnej mapy ShipsGo
  checkedAt       DateTime? @map("checked_at") // checked_at z ShipsGo
  discardedAt     DateTime? @map("discarded_at") // discarded_at z ShipsGo = rejs zakończony
  lastPolledAt    DateTime? @map("last_polled_at") // ostatnie odpytanie ShipsGo (nie: ostatnie wejście usera)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  users ContainerTrackingUser[]

  @@index([containerNumber])
  @@index([fetchState, lastPolledAt])
  @@map("container_tracking")
}

// container_tracking_users — kto śledzi który rejs. Osobna tabela, bo dwóch
// użytkowników może śledzić ten sam kontener: przesyłka w ShipsGo jest JEDNA
// i kredyt poszedł RAZ, ale lista jest per użytkownik.
//
// `hiddenAt` zamiast kasowania wiersza: „Usuń z listy" ukrywa rejs u tego
// użytkownika, ale NIE usuwa śledzenia w ShipsGo (tam usunięcie jest
// nieodwracalne, a ponowne dodanie to nowy kredyt). Dzięki temu ponowne
// wpisanie tego samego numeru przywraca wpis za darmo.
model ContainerTrackingUser {
  id         String            @id @default(uuid())
  userId     String            @map("user_id")
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackingId String            @map("tracking_id")
  tracking   ContainerTracking @relation(fields: [trackingId], references: [id], onDelete: Cascade)
  hiddenAt   DateTime?         @map("hidden_at")
  addedAt    DateTime          @default(now()) @map("added_at")

  @@unique([userId, trackingId])
  @@index([userId, hiddenAt])
  @@map("container_tracking_users")
}
